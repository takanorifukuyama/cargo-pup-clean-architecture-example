// These are IMPORT restrictions, not a complete resolved dependency graph.
// The regression suite checks both detection and a known fully-qualified-path gap.
(
    lints: [
        Module((
            name: "domain_inward_only",
            matches: Module("^clean_architecture::domain(::|$)"),
            rules: [
                RestrictImports(
                    allowed_only: None,
                    denied: Some([
                        "(^|::)(application|infrastructure|presentation)(::|$)",
                        "^(axum|sqlx|tokio|reqwest)(::|$)",
                        "^std::(fs|net|process)(::|$)",
                    ]),
                    severity: Error,
                ),
            ],
        )),
        Module((
            name: "application_inward_only",
            matches: Module("^clean_architecture::application(::|$)"),
            rules: [
                RestrictImports(
                    allowed_only: None,
                    denied: Some([
                        "(^|::)(infrastructure|presentation)(::|$)",
                        "^(axum|sqlx|reqwest)(::|$)",
                    ]),
                    severity: Error,
                ),
            ],
        )),
        Module((
            name: "presentation_no_direct_storage",
            matches: Module("^clean_architecture::presentation(::|$)"),
            rules: [
                RestrictImports(
                    allowed_only: None,
                    denied: Some([
                        "(^|::)infrastructure(::|$)",
                        "^sqlx(::|$)",
                    ]),
                    severity: Error,
                ),
            ],
        )),
        Module((
            name: "infrastructure_uses_domain_ports",
            matches: Module("^clean_architecture::infrastructure(::|$)"),
            rules: [
                RestrictImports(
                    allowed_only: None,
                    denied: Some([
                        "(^|::)(application|presentation)(::|$)",
                    ]),
                    severity: Error,
                ),
            ],
        )),
    ],
)
