// cargo-pup 0.1.8. These are regexes, NOT glob patterns.
// Root modules and their descendants must both match.
(
    lints: [
        Module((
            name: "domain_no_outer_imports",
            matches: Module("^clean_architecture::domain(::|$)"),
            rules: [
                RestrictImports(
                    allowed_only: None,
                    denied: Some([
                        "(^|::)(application|infrastructure|presentation)(::|$)",
                        "^(axum|sqlx|tokio|reqwest)(::|$)",
                        "^std::(fs|net|io|process)(::|$)",
                    ]),
                    severity: Error,
                ),
            ],
        )),
        Module((
            name: "application_no_adapters",
            matches: Module("^clean_architecture::application(::|$)"),
            rules: [
                RestrictImports(
                    allowed_only: None,
                    denied: Some([
                        "(^|::)(infrastructure|presentation)(::|$)",
                        "^(axum|sqlx|reqwest)(::|$)",
                    ]),
                    severity: Error,
                ),
            ],
        )),
        Module((
            name: "presentation_no_infrastructure",
            matches: Module("^clean_architecture::presentation(::|$)"),
            rules: [
                RestrictImports(
                    allowed_only: None,
                    denied: Some([
                        "(^|::)infrastructure(::|$)",
                        "^sqlx(::|$)",
                    ]),
                    severity: Error,
                ),
            ],
        )),
        Module((
            name: "infrastructure_no_presentation",
            matches: Module("^clean_architecture::infrastructure(::|$)"),
            rules: [
                RestrictImports(
                    allowed_only: None,
                    denied: Some(["(^|::)presentation(::|$)"]),
                    severity: Error,
                ),
            ],
        )),
        Struct((
            name: "repository_adapters_implement_port",
            matches: Name(".*TaskRepository$"),
            rules: [
                ImplementsTrait("^clean_architecture::application::TaskRepository$", Error),
            ],
        )),
    ],
)
